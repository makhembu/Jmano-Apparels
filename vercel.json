{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|_next/|static/|favicon.ico|sitemap.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}